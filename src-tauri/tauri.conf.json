{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSSS",
  "version": "0.1.0",
  "identifier": "com.rsss.app",
  "build": {
    "beforeDevCommand": "npm run tauri:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run tauri:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RSSS - RSS Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:rsss.db"]
    }
  }
}
