{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rsss",
	"main": "src/server/index.ts",
	"compatibility_date": "2025-01-22",
	"compatibility_flags": [
		"nodejs_compat"
	],

	/**
	 * Durable Objects - each user gets their own DO with SQLite
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_DO",
				"class_name": "UserDO"
			}
		]
	},

	/**
	 * Migrations for Durable Objects
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CollieUserDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["CollieUserDO"],
			"new_sqlite_classes": ["UserDO"]
		}
	],

	/**
	 * KV namespace for user session data and user->DO mappings
	 */
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "43728a08638d483d80bfb830d2cd4dc5",
			
			// Optional: preview_id used for `wrangler dev` / local dev
			"preview_id": "ab4cfea82e4546ca8ec79170aaabde38"
		},
		{
			"binding": "BLURHASH_KV",
			"id": "f1ffa380aea548aebc5c83fb19ca8de7",
			"preview_id": "7361bc827bd143aa82a5770bfc3e3a25"
		},
		{
			"binding": "HTML_KV",
			"id": "8576d34d4e0a46d8bd2567339eeeed8f",
			"preview_id": "3051be85a6614268b5497717ff74e596"
		}
	],

	/**
	 * Queue infrastructure for async BlurHash generation
	 */
	"queues": {
		"producers": [
			{
				"binding": "BLURHASH_QUEUE",
				"queue": "blurhash-jobs"
			}
		],
		"consumers": [
			{
				"queue": "blurhash-jobs",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "blurhash-dlq"
			}
		]
	},

	/**
	 * Static Assets (Preact frontend)
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		"directory": "./public/",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},

	"vars": {
		"NODE_ENV": "development"
	},

	"observability": {
		"enabled": true
	},

	"dev": {
		"port": 9999
	}
}
